# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://kitawisata:kitawisata@localhost:5432/kitawisata?schema=public"
# Generate with: npx auth secret
AUTH_SECRET="change-me"
# dev: OTP codes are printed to the server console instead of sent by SMS/WhatsApp
OTP_DELIVERY="console"
# Optional: key for encrypting payment gateway keys saved on Payment settings (defaults to one derived
# from AUTH_SECRET). Generate with: openssl rand -base64 32
# PAYMENT_SECRETS_KEY=""
# Public address of the site, used for payment return and webhook URLs.
APP_URL="http://localhost:3000"
# Test only: point gateway calls at a local stand-in (see e2e/README.md). Leave unset in real use.
# MIDTRANS_SNAP_BASE="http://localhost:4010"
# MIDTRANS_API_BASE="http://localhost:4010"
# XENDIT_API_BASE="http://localhost:4010"
